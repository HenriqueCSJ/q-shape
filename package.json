{
  "name": "q-shape",
  "version": "1.5.0",
  "packageManager": "npm@10.8.2",
  "description": "Quantitative Shape Analyzer for Coordination Geometry Analysis",
  "homepage": "https://HenriqueCSJ.github.io/q-shape",
  "private": true,
  "dependencies": {
    "munkres-js": "^1.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "three": "^0.147.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "validate:test": "node --test validation/tests/*.test.cjs",
    "validate:direct:test": "node --test validation/tests/direct-parity-*.test.cjs",
    "validate:direct": "node validation/scripts/run-direct-parity.cjs",
    "validate:direct:verify": "node validation/scripts/verify-direct-parity.cjs",
    "validate:metamorphic:test": "node --test validation/tests/*metamorphic*.test.cjs validation/tests/prepare-metamorphic-references.test.cjs validation/tests/freeze-metamorphic-execution-inputs.test.cjs",
    "validate:metamorphic:prepare": "node validation/scripts/prepare-metamorphic-references.cjs",
    "validate:metamorphic:freeze": "node validation/scripts/freeze-metamorphic-execution-inputs.cjs",
    "validate:metamorphic": "node validation/scripts/run-metamorphic-parity.cjs",
    "validate:metamorphic:verify": "node validation/scripts/verify-metamorphic-parity.cjs --package",
    "coverage:critical": "node scripts/check-critical-coverage.cjs coverage/coverage-summary.json",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "!src/reportWebVitals.js",
      "!src/setupTests.js",
      "!src/**/testUtils/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 23,
        "functions": 35,
        "lines": 31,
        "statements": 30
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "decimal.js": "^10.6.0",
    "gh-pages": "^6.1.1"
  }
}
